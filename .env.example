# Copie para .env e preencha. O .env NÃO deve ser versionado.
# Em GitHub Actions estes valores vão em Settings -> Secrets and variables -> Actions.

# Personal Access Token do Airtable com escopos data.records:read e data.records:write
# limitado à base Central Inteligente de Monitoramento de Carteira de Ativos.
AIRTABLE_TOKEN=

# Token da brapi.dev.
BRAPI_TOKEN=

# Opcionais — só preencha se mudar de base ou tabela.
# AIRTABLE_BASE_ID=appQRtll47wtmzBjR
# AIRTABLE_TABLE_ID=tblJI93swMdRzlNG0
